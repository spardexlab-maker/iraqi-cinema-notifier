# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram Chat ID (or Group/Channel ID). Leave empty if you will send /start to the bot.
TELEGRAM_CHAT_ID=

# How often to check Iraqi Cinema (in minutes)
CHECK_INTERVAL_MINUTES=5

# Optional: Filter specific cinema branches (comma-separated, leave empty for ALL branches)
# Example: Mansour,Baghdad,Iraq Mall
BRANCH_FILTER=

# Path to SQLite database
DB_PATH=data/cinema_notifier.db
